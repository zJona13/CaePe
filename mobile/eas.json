{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REEMPLAZA-con-tu-backend.onrender.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://REEMPLAZA.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REEMPLAZA-con-tu-anon-key"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REEMPLAZA-con-tu-backend.onrender.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://REEMPLAZA.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REEMPLAZA-con-tu-anon-key"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
