DATABASE_URL=postgresql+psycopg://caepe:caepe@localhost:5432/caepe

# Supabase: solo necesitas estos dos.
# El JWKS URL y el issuer se derivan automáticamente de SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=YOUR-SUPABASE-JWT-SECRET
SUPABASE_JWT_LEEWAY_SECONDS=60

# Push notifications (Expo). PUSH_ENABLED=false desactiva el envío real (tests/local).
# EXPO_ACCESS_TOKEN es opcional (solo si activas "Enhanced Security" en Expo).
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
