DATABASE_URL=postgresql+psycopg://caepe:caepe@localhost:5432/caepe

# URL web pública (Vercel) usada para el link de invitación que se comparte por WhatsApp.
PUBLIC_WEB_URL=https://caepe.lat

# Supabase: solo necesitas estos dos.
# El JWKS URL y el issuer se derivan automáticamente de SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=YOUR-SUPABASE-JWT-SECRET
SUPABASE_JWT_LEEWAY_SECONDS=60

# Push notifications (Expo). PUSH_ENABLED=false desactiva el envío real (tests/local).
# EXPO_ACCESS_TOKEN es opcional (solo si activas "Enhanced Security" en Expo).
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# --- Mercado Pago (monetización) ---
# Local: usa las credenciales de PRUEBA (TEST-...). Producción: las de producción.
# Si MP_ACCESS_TOKEN está vacío, /billing/*/checkout responde 503.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# "Clave secreta" del webhook (panel MP) para validar la firma. Vacío = no se valida (local).
MP_WEBHOOK_SECRET=
# true = usar sandbox_init_point (pruebas). false = init_point (producción).
MP_SANDBOX=true
# URL pública del backend para el notification_url del webhook.
API_PUBLIC_URL=https://caepe.onrender.com
